# BookiOps Backend
PORT=5050

# Admin JWT (iss=bookiops-admin)
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-min-32-chars
ADMIN_JWT_EXPIRES_IN=8h

# Restaurant ingest JWT (iss=bookiops-restaurant) — separate from admin
RESTAURANT_JWT_SECRET=change-me-restaurant-jwt-secret-min-32
RESTAURANT_JWT_EXPIRES_IN=2h

# Seed admin (created on boot if missing)
SEED_ADMIN_EMAIL=admin@booki.co.za
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_ADMIN_NAME=BookiOps Admin

# Firebase (bookiops project) — drop *firebase-adminsdk*.json in this folder
# or set an explicit path / single-line JSON:
# FIREBASE_CREDENTIALS_PATH=./bookiops-firebase-adminsdk.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIRESTORE_DATABASE_ID=(default)

# phone.booki.co.za / local twilio_openai
PHONE_API_BASE_URL=http://localhost:5014
INTERNAL_API_KEY=change-me-shared-internal-api-key

# CORS — BookiOps FE + mybooki
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://booki.co.za,https://ops.booki.co.za
